<!-- añado camppo oculto con solucion y poder gestionar mas preguntas-->
<form method="get" action="/quizes/answer">

    Pregunta: <%= pregunta %>

    <p>
        <input
            type="text"
            name="respuesta"
            placeholder="Escribe tu respuesta">
    </p>

    <input
        type="hidden"
        name="solucion"
        value="<%= solucion %>">

    <input type="submit" value="Enviar">

</form>
